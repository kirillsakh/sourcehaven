# Placeholders only. Copy to .env and replace every "replace-me"; never commit real values.
# Operations and configuration reference: docs/superpowers/specs/2026-11-19-sourcehaven-design.md, section 12.

# Postgres container (read by the database service, not by the application).
POSTGRES_USER=sourcehaven_admin
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=sourcehaven

# Compose does not hand this file to the containers wholesale: compose.yaml forwards to each service
# only the variables it needs (the api and worker never see the owner or maintenance credentials or
# the Postgres password). A new application setting must be added to x-app-settings there.
SOURCEHAVEN_ENVIRONMENT=development

# Inside Compose the database host is the service name "db"; host-side tools use 127.0.0.1:55432
# (published by compose.dev.yaml).
# Application role (non-owner, row-level security applies).
SOURCEHAVEN_DATABASE_URL=postgresql+psycopg://sourcehaven_app:replace-me@db:5432/sourcehaven
# Maintenance role (BYPASSRLS, cleanup only).
SOURCEHAVEN_MAINTENANCE_DATABASE_URL=postgresql+psycopg://sourcehaven_maintenance:replace-me@db:5432/sourcehaven
# Owner role, used only by `sourcehaven migrate`.
SOURCEHAVEN_ADMIN_DATABASE_URL=postgresql+psycopg://sourcehaven_admin:replace-me@db:5432/sourcehaven
# Passwords that `sourcehaven migrate` assigns to the two application roles.
SOURCEHAVEN_APP_ROLE_PASSWORD=replace-me
SOURCEHAVEN_MAINTENANCE_ROLE_PASSWORD=replace-me

# Address (or comma-separated addresses) of the reverse proxy whose X-Forwarded-* headers uvicorn
# trusts for client IP and scheme (uvicorn's forwarded_allow_ips). compose.yaml deliberately does not
# forward this value: compose.dev.yaml sets it for the dev api and the production Compose file (M7)
# will pin Caddy's address. It applies only to `sourcehaven serve` run outside Compose.
SOURCEHAVEN_TRUSTED_PROXY=127.0.0.1

SOURCEHAVEN_UPLOADS_DIR=/var/lib/sourcehaven/uploads

# Embeddings: "tei" (requires a pinned revision) or "hash" (development and tests only).
# Fully offline development uses SOURCEHAVEN_EMBEDDING_PROVIDER=hash together with
# SOURCEHAVEN_GENERATION_PROVIDER=fake (no model download and no API key; answers are canned).
SOURCEHAVEN_EMBEDDING_PROVIDER=tei
SOURCEHAVEN_TEI_URL=http://embeddings:80
SOURCEHAVEN_EMBEDDING_MODEL_ID=Snowflake/snowflake-arctic-embed-m-v2.0
# Pinned Hugging Face commit of the model repository, fetched from
# https://huggingface.co/api/models/Snowflake/snowflake-arctic-embed-m-v2.0 on 2026-11-19.
SOURCEHAVEN_EMBEDDING_MODEL_REVISION=95c2741480856aa9666782eb4afe11959938017f
SOURCEHAVEN_EMBEDDING_DIMENSIONS=768
SOURCEHAVEN_EMBEDDING_QUERY_PREFIX="query: "
SOURCEHAVEN_EMBEDDING_DOCUMENT_PREFIX=
# Must equal --max-batch-tokens of the embeddings service in compose.yaml (TEI /info max_input_length).
SOURCEHAVEN_EMBEDDING_MAX_INPUT_TOKENS=2048
# Pinned snapshot of the model's tokenizer.json as the api and worker see it: Compose mounts the
# embeddings model cache (Hugging Face hub layout models--{org}--{name}/snapshots/{revision}/)
# read-only at /models. Must follow SOURCEHAVEN_EMBEDDING_MODEL_ID and _REVISION above.
SOURCEHAVEN_TOKENIZER_FILE=/models/models--Snowflake--snowflake-arctic-embed-m-v2.0/snapshots/95c2741480856aa9666782eb4afe11959938017f/tokenizer.json

SOURCEHAVEN_CHUNK_TOKENS=400
SOURCEHAVEN_CHUNK_OVERLAP=60
SOURCEHAVEN_EVIDENCE_THRESHOLD=0.0

# Generation: "openai" or "fake" (development and tests only). `fake` needs no OPENAI_API_KEY.
SOURCEHAVEN_GENERATION_PROVIDER=openai
OPENAI_API_KEY=replace-me
SOURCEHAVEN_OPENAI_MODEL=gpt-6-luna
# Leave empty to use the model's default. Reasoning models such as gpt-6-luna reject any other
# value (OpenAI returns 400 "Only the default (1) value is supported").
SOURCEHAVEN_GENERATION_TEMPERATURE=
# Reasoning models (such as gpt-5-mini) spend hidden reasoning tokens from the output budget
# before writing the answer; "low" leaves room for the answer. One of minimal, low, medium, high.
# Leave empty for models without reasoning: they reject the setting.
SOURCEHAVEN_OPENAI_REASONING_EFFORT=
# Output budget per answer, reasoning included. An answer cut off by it is shown as incomplete.
SOURCEHAVEN_MAX_OUTPUT_TOKENS=2000

# "turnstile" or "disabled" (development and tests only). compose.dev.yaml sets "disabled" and
# SOURCEHAVEN_COOKIE_SECURE=false (plain HTTP), overriding the values below.
SOURCEHAVEN_HUMAN_VERIFICATION=turnstile
SOURCEHAVEN_COOKIE_SECURE=true

SOURCEHAVEN_MAX_UPLOAD_BYTES=20971520
SOURCEHAVEN_MAX_PAGES_PER_DOCUMENT=300
SOURCEHAVEN_MAX_DOCUMENTS_PER_SESSION=10
SOURCEHAVEN_MAX_QUESTION_CHARS=2000
SOURCEHAVEN_MAX_DOCUMENTS_PER_QUESTION=10
SOURCEHAVEN_SESSION_IDLE_HOURS=24
SOURCEHAVEN_SESSION_ABSOLUTE_DAYS=7
